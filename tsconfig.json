{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "allowJs": false,
    "strict": false,
    "esModuleInterop": true,
    "outDir": "./dist",

    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },

  "include": ["./**/*", "./types/**/*"],
  "exclude": ["node_modules"]
}
